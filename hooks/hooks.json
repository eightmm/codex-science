{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/python_runtime.sh\" \"$PLUGIN_ROOT/scripts/science_hook_dispatch.py\"",
            "timeout": 1800,
            "statusMessage": "Codex Science · 최신 runtime 준비 중"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/python_runtime.sh\" \"$PLUGIN_ROOT/scripts/science_hook_dispatch.py\"",
            "timeout": 1800,
            "statusMessage": "Codex Science · 작업 상태 불러오는 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/python_runtime.sh\" \"$PLUGIN_ROOT/scripts/science_hook_dispatch.py\"",
            "timeout": 20,
            "statusMessage": "Codex Science · 완료 상태 확인 중"
          }
        ]
      }
    ]
  }
}
